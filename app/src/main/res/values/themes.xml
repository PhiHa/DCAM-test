<resources>

    <style name="Theme.DCAMtest" parent="android:style/Theme.Material.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:colorAccent">#FFFFFF</item>
        <item name="android:windowBackground">#000000</item>
    </style>

    <style name="DcamStatusText">
        <item name="android:textColor">#FFFFFF</item>
        <item name="android:textSize">14sp</item>
        <item name="android:paddingStart">4dp</item>
        <item name="android:paddingTop">6dp</item>
        <item name="android:paddingEnd">4dp</item>
        <item name="android:paddingBottom">6dp</item>
    </style>

    <style name="DcamStatusText.Bold" parent="DcamStatusText">
        <item name="android:textStyle">bold</item>
    </style>

    <style name="DcamStatusText.Secondary" parent="DcamStatusText">
        <item name="android:textColor">#CCCCCC</item>
    </style>

    <style name="DcamSettingsHeading" parent="DcamStatusText.Bold">
        <item name="android:paddingTop">8dp</item>
        <item name="android:textSize">22sp</item>
    </style>

    <style name="DcamSettingsHint" parent="DcamStatusText.Secondary">
        <item name="android:paddingTop">0dp</item>
        <item name="android:textSize">12sp</item>
    </style>

    <style name="DcamAppTile">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">124dp</item>
        <item name="android:layout_columnWeight">1</item>
        <item name="android:layout_gravity">fill_horizontal</item>
        <item name="android:layout_margin">6dp</item>
        <item name="android:background">@drawable/bg_setting_card</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:gravity">center</item>
        <item name="android:orientation">vertical</item>
        <item name="android:padding">10dp</item>
    </style>

    <style name="DcamAppTileIcon">
        <item name="android:layout_width">42dp</item>
        <item name="android:layout_height">42dp</item>
    </style>

    <style name="DcamAppTileLabel" parent="DcamStatusText.Bold">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">8dp</item>
        <item name="android:gravity">center</item>
        <item name="android:maxLines">2</item>
        <item name="android:padding">0dp</item>
        <item name="android:textSize">13sp</item>
    </style>

    <style name="DcamSettingRow" parent="DcamStatusText">
        <item name="android:background">@drawable/bg_setting_card</item>
        <item name="android:layout_marginBottom">8dp</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:padding">14dp</item>
        <item name="android:textColor">#E5EDF5</item>
        <item name="android:textSize">14sp</item>
    </style>
</resources>
