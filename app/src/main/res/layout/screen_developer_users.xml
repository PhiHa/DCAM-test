<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            style="@style/DcamSettingsHeading"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/developer_users" />

        <TextView
            style="@style/DcamSettingsHint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:text="@string/developer_users_hint" />

        <EditText
            android:id="@+id/user_id"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/user_id"
            android:inputType="number"
            android:maxLength="6"
            android:singleLine="true"
            android:textColor="#FFFFFF"
            android:textColorHint="#999999" />

        <EditText
            android:id="@+id/login_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/login_name_optional"
            android:inputType="text"
            android:maxLength="64"
            android:singleLine="true"
            android:textColor="#FFFFFF"
            android:textColorHint="#999999" />

        <EditText
            android:id="@+id/display_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/display_name"
            android:inputType="textPersonName"
            android:maxLength="80"
            android:singleLine="true"
            android:textColor="#FFFFFF"
            android:textColorHint="#999999" />

        <EditText
            android:id="@+id/password"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/password_text"
            android:inputType="textPassword"
            android:maxLength="64"
            android:singleLine="true"
            android:textColor="#FFFFFF"
            android:textColorHint="#999999" />

        <Button
            android:id="@+id/save_action"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/save_user" />

        <TextView
            android:id="@+id/status"
            style="@style/DcamStatusText.Secondary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="42dp" />
    </LinearLayout>
</ScrollView>
